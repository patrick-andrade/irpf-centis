  "private": true,
  "description": "Camada visual do irpf-centis: páginas Explorar (Quarto + OJS) e figuras dos relatórios.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "build": "node scripts/bundle-js.mjs",
