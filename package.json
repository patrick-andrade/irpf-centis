    "medir": "node scripts/medir-carga.mjs"
  },
  "dependencies": {
    "@observablehq/plot": "0.6.17",
    "d3": "7.9.0",
    "htl": "1.0.0"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "opentype.js": "2.0.0",
    "puppeteer-core": "25.13.0"
  }
}
